{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 静的アセットのみの Worker（vite build の出力をそのまま配信）
  "name": "pokefuta-tracker",
  "compatibility_date": "2026-10-25",
  // 独自ドメイン（DNS レコードと証明書は Cloudflare が自動で作成する）
  "routes": [{ "pattern": "pokefuta.solclarus.me", "custom_domain": true }],
  // 移行期間中は旧 URL（*.workers.dev）も残す
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
